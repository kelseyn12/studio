DATABASE_URL="file:../data/studio.db"
SESSION_SECRET="change-this-to-a-long-random-string"
STUDIO_PIN="4242"

# Outstand — https://www.outstand.so/docs/getting-started
OUTSTAND_API_KEY=""
OUTSTAND_ORG_ID=""
OUTSTAND_REDIRECT_URI="http://localhost:3000/connections/callback"

# Optional — gpt-4o-transcribe + hook rewrite (voice note → editor brief, plus Transcribe page)
OPENAI_API_KEY=""

# Optional — ManyChat comment DMs + job pings
MANYCHAT_API_KEY=""
MANYCHAT_EDITOR_ID=""
MANYCHAT_CREATOR_ID=""
MANYCHAT_CHANNEL="instagram"

# Cloudflare R2 — this is where videos live. Without these keys, uploads sit on this Mac.
# Create a bucket: Cloudflare dashboard → R2 → Create bucket. Public URL is the custom domain or r2.dev link.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# Clerk — required before a VA logs in from their computer. PIN is local-only and turns off when these are set.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Fly / always-on host
# UPLOAD_ROOT="/data/uploads"
# HOOK_FONT="/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"

# Turso — shared cloud database so local and Fly see the same data
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Public URL of the app, used to build tracked short links
APP_URL="http://localhost:3000"
