generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  CREATOR
  EDITOR
  OPERATOR
}

enum CardStatus {
  IDEA
  SCRIPTED
  FILMED
  EDITING
  REVIEW
  READY
  POSTED
  DATA
}

enum FormatLane {
  WINNER
  CHALLENGER
  TEST
}

enum AssetKind {
  RAW
  VOICE
  EDITED
  REFERENCE
  THUMB
  GENERATED
}

enum DealKind {
  TECH
  UGC
}

enum CampaignStatus {
  TRIAL
  ACTIVE
  PAUSED
  ENDED
}

enum ApprovalFriction {
  NONE
  LOW
  STRICT
}

enum PublishStatus {
  DRAFT
  QUEUED
  PUBLISHED
  FAILED
  CANCELLED
}

enum ClipSlot {
  HOOK
  DEMO
  CTA
}

enum CutBy {
  SELF
  EDITOR
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  role           Role
  pinHash        String?
  clerkId        String?  @unique
  defaultEditor  Boolean  @default(false)
  createdAt      DateTime @default(now())
  cards          Card[]   @relation("CreatedCards")
  edits          Card[]   @relation("EditorCards")
}

model Campaign {
  id                    String           @id @default(cuid())
  name                  String
  brand                 String
  kind                  DealKind         @default(UGC)
  status                CampaignStatus   @default(TRIAL)
  videoCount            Int              @default(3)
  deadlineAt            DateTime?
  deliverables          String           @default("")
  basePayCents          Int
  postsPerDay           Int
  accountsAllowed       Int              @default(1)
  minutesPerPost        Int              @default(10)
  minViews              Int              @default(0)
  approvalFriction      ApprovalFriction @default(LOW)
  approvalHours         Int              @default(24)
  creativeFreedom       Int              @default(3)
  managerName           String           @default("")
  managerResponsive     Boolean          @default(true)
  othersViral           Boolean          @default(false)
  briefSupply           Boolean          @default(false)
  editorIncluded        Boolean          @default(false)
  cpmCents              Int              @default(0)
  monthlyHoursEstimate  Int              @default(15)
  notes                 String           @default("")
  createdAt             DateTime         @default(now())
  formats               Format[]
  cards                 Card[]
  accounts              SocialAccount[]
}

model Format {
  id         String           @id @default(cuid())
  campaignId String
  campaign   Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  lane       FormatLane       @default(TEST)
  notes      String           @default("")
  cards      Card[]
  batches    RepurposeBatch[]
}

model Card {
  id               String          @id @default(cuid())
  title            String
  status           CardStatus      @default(IDEA)
  campaignId       String?
  campaign         Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  formatId         String?
  format           Format?         @relation(fields: [formatId], references: [id], onDelete: SetNull)
  accountId        String?
  account          SocialAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?           @relation("CreatedCards", fields: [createdById], references: [id], onDelete: SetNull)
  editorId         String?
  editor           User?           @relation("EditorCards", fields: [editorId], references: [id], onDelete: SetNull)
  cutBy            CutBy           @default(SELF)
  premise          String          @default("")
  hook             String          @default("")
  body             String          @default("")
  plug             String          @default("")
  script           String          @default("")
  caption          String          @default("")
  referenceUrl     String          @default("")
  rawsUrl          String          @default("")
  editorNote       String          @default("")
  captionStyle     String          @default("")
  plannedDate      DateTime?
  scheduledAt      DateTime?
  postedAt         DateTime?
  deadlineAt       DateTime?
  paid             Boolean         @default(true)
  approved         Boolean         @default(false)
  payoutCents      Int             @default(0)
  views            Int             @default(0)
  likes            Int             @default(0)
  comments         Int             @default(0)
  shares           Int             @default(0)
  saves            Int             @default(0)
  skipRate         Float           @default(0)
  outstandPostId   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  assets           Asset[]
  publishes        PublishJob[]
}

model Asset {
  id        String    @id @default(cuid())
  cardId    String
  card      Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  kind      AssetKind
  filename  String
  path      String
  mime      String
  size      Int
  publicUrl String    @default("")
  textStyle String    @default("")
  createdAt DateTime  @default(now())
}

model SocialAccount {
  id                String   @id @default(cuid())
  outstandAccountId String   @unique
  network           String
  username          String
  nickname          String   @default("")
  isActive          Boolean  @default(true)
  campaignId        String?
  campaign          Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  cards             Card[]
  publishes         PublishJob[]
}

model PublishJob {
  id                String        @id @default(cuid())
  cardId            String
  card              Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  accountId         String
  account           SocialAccount @relation(fields: [accountId], references: [id])
  outstandPostId    String?
  platformPostId    String?
  status            PublishStatus @default(DRAFT)
  error             String?
  scheduledAt       DateTime?
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
}

model Transcript {
  id        String   @id @default(cuid())
  title     String
  sourceUrl String   @default("")
  filename  String   @default("")
  text      String
  createdAt DateTime @default(now())
}

model RepurposeBatch {
  id          String           @id @default(cuid())
  name        String
  status      String           @default("draft")
  speedOn     Boolean          @default(true)
  colorOn     Boolean          @default(false)
  zoomOn      Boolean          @default(false)
  speedAmt     Int              @default(2)
  colorAmt     Int              @default(8)
  cropAmt      Int              @default(4)
  allCombos   Boolean          @default(true)
  count       Int              @default(12)
  variants    Int              @default(2)
  mirrorOn    Boolean          @default(false)
  trimOn      Boolean          @default(false)
  hookColorOn Boolean          @default(false)
  captionsOn  Boolean          @default(false)
  textStyle   String           @default("auto")
  listCount   Int              @default(0)
  tintAmt     Int              @default(0)
  formatId    String?
  format      Format?          @relation(fields: [formatId], references: [id], onDelete: SetNull)
  hookLines   String           @default("")
  caption     String           @default("")
  campaignId  String?
  accountId   String?
  createdAt   DateTime         @default(now())
  clips       RepurposeClip[]
  tracks      RepurposeTrack[]
  outputs     RepurposeOut[]
}

model RepurposeClip {
  id       String         @id @default(cuid())
  batchId  String
  batch    RepurposeBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  slot     ClipSlot
  path     String
  filename String
  hookText String         @default("")
  thumbPath String        @default("")
  size     Int            @default(0)
  captionsJson String     @default("")
}

model RepurposeTrack {
  id       String         @id @default(cuid())
  batchId  String
  batch    RepurposeBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  path     String
  filename String
  size     Int            @default(0)
}

model RepurposeOut {
  id      String         @id @default(cuid())
  batchId String
  batch   RepurposeBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  cardId  String?
  path    String
  label   String
}

model WeeklyReview {
  id        String   @id @default(cuid())
  weekStart DateTime
  notes     String   @default("")
  hours     Int      @default(0)
  createdAt DateTime @default(now())
}

model ShortLink {
  id        String   @id @default(cuid())
  slug      String   @unique
  targetUrl String
  label     String   @default("")
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
}

model DmRecipe {
  id        String   @id @default(cuid())
  trigger   String
  message   String
  channel   String   @default("instagram")
  createdAt DateTime @default(now())
}
